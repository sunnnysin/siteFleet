    "@react-navigation/native-stack": "^7.17.9",
    "date-fns": "^4.4.0",
    "firebase": "^12.15.0",
    "react": "19.2.3",
    "react-hook-form": "^7.81.0",
    "react-native": "0.86.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-html-to-pdf": "^1.3.0",
    "react-native-mmkv": "^4.3.2",
