rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerRead() {
      return isSignedIn() &&
        (resource == null || resource.data.ownerId == request.auth.uid);
    }

    function isOwnerWrite() {
      return isSignedIn() &&
        (resource == null || resource.data.ownerId == request.auth.uid) &&
        (request.resource == null ||
          request.resource.data.ownerId == request.auth.uid);
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && userId == request.auth.uid;
    }

    match /drivers/{driverId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /routes/{routeId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /fuelPrices/{priceId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /dailyEntries/{entryId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /monthlyPayments/{paymentId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /pumpEntries/{pumpEntryId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /vehicleRates/{vehicleRateId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /driverAdvances/{driverAdvanceId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /goraulSummaries/{goraulSummaryId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /goraulVehicleRates/{goraulVehicleRateId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }

    match /dieselDistributions/{dieselDistributionId} {
      allow read: if isOwnerRead();
      allow write: if isOwnerWrite();
    }
  }
}
